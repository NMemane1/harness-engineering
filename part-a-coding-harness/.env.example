# Copy to .env (or just export these) before running the harness.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here
# Optional: pick any OpenRouter model id. Good coding choices:
#   deepseek/deepseek-chat         (default; cheap + strong)
#   google/gemini-2.0-flash-001    (your student Gemini-tier, very cheap)
#   anthropic/claude-3.5-sonnet    (strongest, pricier)
HARNESS_MODEL=deepseek/deepseek-chat
